---
import { getCollection, type CollectionEntry } from "astro:content";

import Layout from "../layout/Layout.astro";
import Link from "../components/Link.astro";
import Posts from "../components/Posts.astro";
import { SITE } from "../config";

const posts: CollectionEntry<"blog">[] = await getCollection(
  "blog",
  ({ data }) => !data.draft,
);

const recent = [...posts]
  .sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate))
  .slice(0, 5);

const yo = new Date().getFullYear() - new Date(2004, 1, 4).getFullYear();

const nav = [
  { label: "posts", href: "/blog" },
  { label: "tags", href: "/tags" },
  { label: "rss", href: "/rss.xml", isExternal: true },
];
---

<Layout maxWidth="760px" footerVariant="centered">
  <div class="mx-auto max-w-150 text-center">
    <h1
      class="font-serif text-[42px] font-medium leading-[1.05] tracking-tight"
    >
      {SITE.author}
    </h1>
    <p
      class="mt-3 font-mono text-[11px] tracking-[0.14em] uppercase text-accent"
    >
      Thoughts on PL, CS &amp; Math
    </p>

    <nav class="mt-5">
      <ul
        class="flex justify-center gap-6 font-mono text-[11px] tracking-wider text-muted"
      >
        {
          nav.map((item) => (
            <li>
              <Link href={item.href} isExternal={item.isExternal}>
                {item.label}
              </Link>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="mt-9 font-serif text-[17px] md:text-[19px] leading-[1.75]">
      Living in Brazil, {yo}yo. In my free time, I like to learn about CS,
      philosophy, read books/mangas, care for my health, and occasionally write
      something here.
    </p>
  </div>

  <div class="mx-auto mt-14 max-w-130">
    <div class="h-px w-full bg-rule"></div>
    <p
      class="mt-12 mb-2 text-center font-mono text-[11px] tracking-[0.18em] uppercase text-muted"
    >
      Posts
    </p>
    <Posts posts={recent} />
    <div class="mt-10 text-center">
      <Link
        href="/blog"
        class="font-mono text-[11px] tracking-wider text-accent"
      >
        see all posts &rarr;
      </Link>
    </div>
  </div>
</Layout>
