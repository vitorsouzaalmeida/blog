---
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { site } from '../site';

const posts = await getPosts();
---

<Layout canonical="/">
  <p>
    My interests include reading, writing, math/mathematical thinking, logic,
    philosophy, software engineering, functional programming, distributed
    systems, etc.
  </p>
  <nav aria-label="Links">
    <ul class="links" role="list">
      <li>
        <a href={site.github} rel="noreferrer noopener">
          github
        </a>
      </li>
      <li>
        <a href={site.linkedin} rel="noreferrer noopener">
          linkedin
        </a>
      </li>
    </ul>
  </nav>
  <h2>posts</h2>
  <PostList posts={posts} />
</Layout>
