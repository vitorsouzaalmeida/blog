---
import { getCollection, type CollectionEntry } from "astro:content";

import Link from "../../../components/Link.astro";
import Layout from "../../../layout/Layout.astro";
import NavOptions from "../../../components/NavOptions.astro";
import { SITE } from "../../../config";
import { getThread, getThreadParts } from "../../../threads";

interface Props {
  post: CollectionEntry<"blog">;
}

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      slug: post.slug,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;

const { Content } = await post.render();

const d = post.data.pubDate;
const datePart = [
  d.getUTCFullYear(),
  String(d.getUTCMonth() + 1).padStart(2, "0"),
  String(d.getUTCDate()).padStart(2, "0"),
].join(" · ");
const tags = post.data.tags ?? [];

const threadId = post.data.thread;
const thread = threadId ? getThread(threadId) : undefined;
const parts = thread ? await getThreadParts(thread.id) : [];
const partIndex = parts.findIndex((p) => p.slug === post.slug);
// Only surface the thread once it has a second part to navigate to.
const threadNav =
  thread && parts.length >= 2 && partIndex >= 0
    ? {
        thread,
        index: partIndex + 1,
        total: parts.length,
        prev: parts[partIndex - 1] ?? null,
        next: parts[partIndex + 1] ?? null,
      }
    : null;
---

<Layout
  ogImage={`/blog/${post.slug}.png`}
  head={{ title: `${post.data.title} | ${SITE.title}` }}
>
  <NavOptions />

  <header class="mt-10">
    <p class="font-mono text-[11px] tracking-[0.06em] text-muted">
      {datePart}
      {
        tags.length > 0 && (
          <>
            {" — "}
            {tags.map((tag: string, i: number) => (
              <>
                {i > 0 && " · "}
                <Link href={`/tag/${tag}`}>{tag}</Link>
              </>
            ))}
          </>
        )
      }
    </p>

    <h1
      class="mt-4 font-serif text-[38px] font-medium leading-[1.12] tracking-tight"
    >
      {post.data.title}
    </h1>

    {
      post.data.subtitle && (
        <p class="mt-2 font-serif text-[20px] italic text-muted">
          {post.data.subtitle}
        </p>
      )
    }

    {
      threadNav && (
        <div class="mt-6 rounded-[3px] border border-rule px-4 py-3">
          <p class="font-mono text-[11px] tracking-[0.06em] text-muted">
            <Link href={`/thread/${threadNav.thread.id}`} class="text-accent">
              &#8627; {threadNav.thread.title}
            </Link>
            <span>
              {" "}
              &middot; part {threadNav.index} of {threadNav.total}
            </span>
          </p>
          {(threadNav.prev || threadNav.next) && (
            <div class="mt-2 flex justify-between gap-6 font-mono text-[11px] tracking-[0.06em] text-muted">
              {threadNav.prev ? (
                <Link href={`/blog/${threadNav.prev.slug}`}>
                  &larr; {threadNav.prev.data.title}
                </Link>
              ) : (
                <span />
              )}
              {threadNav.next ? (
                <Link href={`/blog/${threadNav.next.slug}`} class="text-right">
                  {threadNav.next.data.title} &rarr;
                </Link>
              ) : (
                <span />
              )}
            </div>
          )}
        </div>
      )
    }
  </header>

  <article class="mt-10">
    <Content />
  </article>
</Layout>
