---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsResult } from "astro";

import Layout from "../../layout/Layout.astro";
import Posts from "../../components/Posts.astro";
import GoBackButton from "../../components/NavOptions.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

export const prerender = true;
export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  const posts = await getCollection("blog");

  const existentTags = posts.reduce(
    (tags, post) => new Set([...tags, ...(post.data.tags || [])]),
    new Set<string>(),
  );

  const postsPerTag: Record<string, CollectionEntry<"blog">[]> = {};

  existentTags.forEach((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags?.includes(tag));
    postsPerTag[tag] = filteredPosts;
  });

  return Object.entries(postsPerTag).map(([tag, posts]) => ({
    params: {
      tag,
    },
    props: {
      posts,
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout>
  <GoBackButton />
  <p
    class="mt-10 mb-6 font-mono text-[11px] tracking-[0.18em] uppercase text-muted"
  >
    Tag &middot; {tag}
  </p>
  <Posts posts={posts} />
</Layout>
