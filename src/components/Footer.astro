---
import Link from "./Link.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  variant?: "split" | "centered";
  maxWidth?: string;
}

const { variant = "split", maxWidth = "640px" } = Astro.props;

const navLinks = [
  {
    title: "Github",
    href: "https://github.com/vitorsouzaalmeida/",
    isExternal: true,
  },
  {
    title: "LinkedIn",
    href: "https://www.linkedin.com/in/vitorsalmeida/",
    isExternal: true,
  },
  { title: "Blog", href: "/blog", isExternal: false },
  { title: "Pics", href: "/pics", isExternal: false },
  { title: "Tags", href: "/tags", isExternal: false },
  { title: "RSS", href: "/rss.xml", isExternal: true },
];

const year = new Date().getUTCFullYear();
---

<footer
  class="w-full mx-auto px-6 mt-12 pt-4 border-t border-rule font-mono text-[11px] tracking-wider text-muted"
  style={`max-width:${maxWidth}`}
>
  {
    variant === "centered" ? (
      <div class="flex flex-col items-center gap-3 py-2">
        <nav>
          <ul class="flex flex-wrap justify-center gap-4.5">
            {navLinks.map((link) => (
              <li>
                <Link href={link.href} isExternal={link.isExternal}>
                  {link.title}
                </Link>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-2 text-muted">
          <span>&copy; {year}</span>
          <ThemeToggle />
        </div>
      </div>
    ) : (
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span>&copy; {year}</span>
          <ThemeToggle />
        </div>
        <nav>
          <ul class="flex flex-wrap justify-end gap-4.5">
            {navLinks.map((link) => (
              <li
                class={
                  link.title === "Tags" || link.title === "RSS"
                    ? "mobile-hidden"
                    : ""
                }
              >
                <Link href={link.href} isExternal={link.isExternal}>
                  {link.title}
                </Link>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )
  }
</footer>

<style>
  li {
    list-style: none;
  }

  @media (max-width: 768px) {
    .mobile-hidden {
      display: none;
    }
  }
</style>
