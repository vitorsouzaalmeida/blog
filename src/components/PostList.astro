---
import { displayDate, isoDate, postUrl, type Post } from '../lib/posts';

type Props = {
  readonly posts: readonly Post[];
};

const { posts } = Astro.props;
---

<ul class="posts" role="list">
  {posts.map((post) => (
    <li>
      <a href={postUrl(post.id)}>{post.data.title}</a>
      {' — '}
      <time datetime={isoDate(post.data.pubDate)}>
        {displayDate(post.data.pubDate)}
      </time>
    </li>
  ))}
</ul>
