---
interface Props {
  href: string;
  isExternal?: boolean;
  class?: string;
}

const { href, isExternal = false, class: className = "" } = Astro.props;

const externalProps = isExternal
  ? { target: "_blank", rel: "noreferrer noopener" }
  : {};
---

<a
  {...externalProps}
  href={href}
  class={`transition-colors duration-150 hover:text-accent ${className}`}
  ><slot /></a
>
