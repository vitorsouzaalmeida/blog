---
import type { CollectionEntry } from "astro:content";

import Link from "./Link.astro";
import { buildThreadMap } from "../threads";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const sorted = [...posts].sort(
  (a, b) => Number(b.data.pubDate) - Number(a.data.pubDate),
);

const threadMap = await buildThreadMap();
---

<ul class="flex flex-col">
  {
    sorted.map((post) => {
      const placement = threadMap.get(post.slug);
      return (
        <li class="flex items-baseline gap-6 py-3.25">
          <time class="shrink-0 w-21.5 font-mono text-[11px] tracking-[0.06em] text-muted">
            {post.data.pubDate.toISOString().split("T")[0]}
          </time>
          <div class="flex-1">
            <Link
              href={`/blog/${post.slug}`}
              class="font-serif text-[16px] md:text-[18px] leading-[1.4]"
            >
              {post.data.title}
            </Link>
            {placement && (
              <Link
                href={`/thread/${placement.thread.id}`}
                class="mt-1 block font-mono text-[10px] tracking-[0.08em] uppercase text-muted"
              >
                &#8627; {placement.thread.title} &middot; part {placement.index}
              </Link>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
