---
import type { CollectionEntry } from "astro:content";

import Link from "./Link.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const sorted = [...posts].sort(
  (a, b) => Number(b.data.pubDate) - Number(a.data.pubDate),
);
---

<ul class="flex flex-col">
  {
    sorted.map((post) => (
      <li class="flex items-baseline gap-6 py-3.25">
        <time class="shrink-0 w-21.5 font-mono text-[11px] tracking-[0.06em] text-muted">
          {post.data.pubDate.toISOString().split("T")[0]}
        </time>
        <Link
          href={`/blog/${post.slug}`}
          class="flex-1 font-serif text-[16px] leading-[1.4]"
        >
          {post.data.title}
        </Link>
      </li>
    ))
  }
</ul>
